# Elevarts Brand Book — local static server (port 3003)
# Cloudflare tunnel rute traffic-ul de la brand.elevarts.com aici.

:3003 {
  root * "/Users/elevartsbrain/Documents/Elevarts Brain/00-BRAND-KIT/brand-book"

  # Default index page = brand book
  rewrite / /elevarts-brand-book.html

  # Pretty URL-uri (opțional, fără .html)
  try_files {path} {path}.html {path}/

  file_server

  # Caching aggressive pe assets (fonts, images, zips)
  @static path *.woff2 *.ttf *.otf *.png *.jpg *.jpeg *.webp *.ico *.svg *.zip
  header @static Cache-Control "public, max-age=31536000, immutable"

  # Conservative pe HTML (refresh des)
  @html path *.html
  header @html Cache-Control "public, max-age=600"

  # Security headers
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }

  # Disable directory browsing (chiar dacă există file_server)
  @blockedDirs path */originals/* */assets/fonts/*
  respond @blockedDirs "Forbidden" 403
}
